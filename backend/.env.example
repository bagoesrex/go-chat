# Server Port
PORT=8080

# PostgreSQL Database Connection URL
# Format: postgres://<user>:<password>@<host>:<port>/<db_name>?sslmode=<disable|require>
DB_URL=postgres://postgres:postgres@localhost:5432/gochat?sslmode=disable

# JWT Secret Key for token signing and verification
JWT_SECRET=super_secret_jwt_key_change_in_production

# Frontend Client Origin for CORS and WebSocket Upgrade Check
CLIENT_ORIGIN=http://localhost:5173
